msgstr "বাকি পেমেন্টের লেখা"

#: ccd-payment-gateway.php:970
#: ccd-payment-gateway.php:1183
msgid "Remaining amount to be paid later:"
msgstr "বাকি টাকা পরে পরিশোধ করতে হবে:"

#: ccd-payment-gateway.php:972
msgid "Customize the text explaining the remaining payment amount. Leave empty to use default. Use {amount} placeholder to show the remaining amount dynamically."
msgstr "বাকি টাকার পরিমাণ বোঝানোর লেখা বদলান। ডিফল্ট ব্যবহার করতে খালি রাখুন। বাকি পরিমাণ দেখাতে {amount} ব্যবহার করুন।"

